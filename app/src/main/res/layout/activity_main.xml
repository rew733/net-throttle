<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="14dp">

    <!-- الشريط العلوي: العنوان + زر التحديث اليدوي + زر التشغيل/الإيقاف -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="NetThrottle"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRefresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تحديث"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="8dp"
            app:backgroundTint="#2E7D32"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleVpn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تشغيل"
            android:textColor="#FFFFFF"
            app:backgroundTint="#1E88E5"
            app:cornerRadius="12dp" />
    </LinearLayout>

    <!-- بطاقة إدخال السرعة كتابةً -->
    <LinearLayout
        android:id="@+id/speedControlCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#1E1E1E"
        android:padding="12dp"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الحد الأقصى (KB/s):"
            android:textColor="#CCCCCC"
            android:textSize="14sp"
            android:layout_marginEnd="10dp" />

        <EditText
            android:id="@+id/etSpeedInput"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="#2A2A2A"
            android:inputType="number"
            android:maxLength="6"
            android:gravity="center"
            android:text="100"
            android:textColor="#4FC3F7"
            android:textSize="17sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApplySpeed"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="تطبيق"
            android:textColor="#FFFFFF"
            app:backgroundTint="#0288D1"
            app:cornerRadius="10dp" />
    </LinearLayout>

    <!-- التبويبات: تحديد السرعة / حظر البيانات -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E1E1E"
        app:tabTextColor="#AAAAAA"
        app:tabSelectedTextColor="#4FC3F7"
        app:tabIndicatorColor="#4FC3F7"
        android:layout_marginBottom="8dp">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تحديد السرعة" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="حظر البيانات" />
    </com.google.android.material.tabs.TabLayout>

    <!-- البحث وأزرار تحديد الكل / إلغاء الكل -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="#1E1E1E"
            android:hint="بحث عن تطبيق..."
            android:textColorHint="#888888"
            android:textColor="#FFFFFF"
            android:paddingHorizontal="12dp"
            android:textSize="14sp"
            android:singleLine="true" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSelectAll"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الكل"
            android:textColor="#4FC3F7"
            android:minWidth="48dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeselectAll"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="إلغاء"
            android:textColor="#EF5350"
            android:minWidth="48dp" />
    </LinearLayout>

    <!-- قائمة التطبيقات -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvApps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
