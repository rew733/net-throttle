<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="14dp">

    <!-- الشريط العلوي: العنوان + زر التحديث اليدوي + زر التشغيل/الإيقاف -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="NetThrottle"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRefresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تحديث"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="8dp"
            app:backgroundTint="#2E7D32"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleVpn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تشغيل"
            android:textColor="#FFFFFF"
            app:backgroundTint="#1E88E5"
            app:cornerRadius="12dp" />
    </LinearLayout>

    <!-- بطاقة إدخال السرعة الأساسية (TCP 80/443) -->
    <LinearLayout
        android:id="@+id/speedControlCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#1E1E1E"
        android:padding="10dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الحد الأساسي (KB/s):"
            android:textColor="#CCCCCC"
            android:textSize="13sp"
            android:layout_marginEnd="8dp" />

        <EditText
            android:id="@+id/etSpeedInput"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="#2A2A2A"
            android:inputType="number"
            android:maxLength="6"
            android:gravity="center"
            android:text="60"
            android:textColor="#4FC3F7"
            android:textSize="17sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApplySpeed"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="تطبيق"
            android:textColor="#FFFFFF"
            app:backgroundTint="#0288D1"
            app:cornerRadius="10dp" />
    </LinearLayout>

    <!-- خيار: التطبيق النشط على الشاشة فقط -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#1B262C"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:layout_marginBottom="8dp">

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchForegroundOnly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="التطبيق المفتوح فقط (حظر الخلفية مع حماية النظام)"
            android:textColor="#E0F7FA"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- بطاقة الإحصائيات الحية والسجل التشخيصي -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#182026"
        android:padding="10dp"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvLiveStats"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="تنزيل: 0 KB/s | رفع: 0 KB/s | اتصالات: 0"
                android:textColor="#81D4FA"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopyLog"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="نسخ السجل"
                android:textColor="#A5D6A7"
                android:textSize="12sp"
                android:minWidth="48dp"
                android:paddingHorizontal="6dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDiagnosticLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="الحالة: متوقف"
            android:textColor="#B0BEC5"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- التبويبات الثلاثة: تحديد السرعة / حظر البيانات / المنافذ -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E1E1E"
        app:tabTextColor="#AAAAAA"
        app:tabSelectedTextColor="#4FC3F7"
        app:tabIndicatorColor="#4FC3F7"
        android:layout_marginBottom="8dp">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تحديد السرعة" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="حظر البيانات" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="المنافذ" />
    </com.google.android.material.tabs.TabLayout>

    <!-- حاوية التبويب الأول والثاني (قائمة التطبيقات والبحث) -->
    <LinearLayout
        android:id="@+id/appsContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="#1E1E1E"
                android:hint="بحث عن تطبيق..."
                android:textColorHint="#888888"
                android:textColor="#FFFFFF"
                android:paddingHorizontal="12dp"
                android:textSize="14sp"
                android:singleLine="true" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelectAll"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الكل"
                android:textColor="#4FC3F7"
                android:minWidth="48dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeselectAll"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="إلغاء"
                android:textColor="#EF5350"
                android:minWidth="48dp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvApps"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- حاوية التبويب الثالث (إدارة المنافذ والبروتوكولات والقياس الحي لكل مسار) -->
    <ScrollView
        android:id="@+id/portsContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- المسار 1: تصفح وبث TCP القياسي (80 / 443) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1E1E1E"
                android:padding="12dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="1. الويب والفيديو (TCP 80 / 443)"
                        android:textColor="#4FC3F7"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvWebTcpLive"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="الحي: 0 KB/s"
                        android:textColor="#A5D6A7"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="يتبع الحد الأساسي المكتوب في الأعلى مع ضبط نافذة الاستقبال."
                    android:textColor="#9E9E9E"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- المسار 2: بث الفيديو السريع UDP 443 (QUIC) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1E1E1E"
                android:padding="12dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="2. فيديو UDP 443 (QUIC)"
                        android:textColor="#FFB74D"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvQuicLive"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="محظور: 0"
                        android:textColor="#EF9A9A"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchBlockQuic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="حظر QUIC (إجبار تيك توك وفيسبوك على TCP المنضبط)"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- المسار 3: المكالمات الصوتية وباقي UDP -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1E1E1E"
                android:padding="12dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="3. المكالمات وباقي UDP"
                        android:textColor="#81C784"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCallsUdpLive"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="الحي: 0 KB/s"
                        android:textColor="#A5D6A7"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchAllowCallsUdp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="السماح بحزم المكالمات الصوتية (WebRTC / STUN)"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="حد حزم UDP في الثانية:"
                        android:textColor="#CCCCCC"
                        android:textSize="12sp"
                        android:layout_marginEnd="8dp" />

                    <EditText
                        android:id="@+id/etCallsPps"
                        android:layout_width="80dp"
                        android:layout_height="38dp"
                        android:background="#2A2A2A"
                        android:inputType="number"
                        android:maxLength="4"
                        android:gravity="center"
                        android:text="30"
                        android:textColor="#81C784"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:singleLine="true" />
                </LinearLayout>
            </LinearLayout>

            <!-- المسار 4: منافذ TCP الأخرى -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1E1E1E"
                android:padding="12dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="4. منافذ TCP الأخرى (Other Ports)"
                        android:textColor="#BA68C8"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvOtherTcpLive"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="الحي: 0 KB/s"
                        android:textColor="#A5D6A7"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="الحد المخصص (KB/s):"
                        android:textColor="#CCCCCC"
                        android:textSize="12sp"
                        android:layout_marginEnd="8dp" />

                    <EditText
                        android:id="@+id/etOtherTcpSpeed"
                        android:layout_width="90dp"
                        android:layout_height="38dp"
                        android:background="#2A2A2A"
                        android:inputType="number"
                        android:maxLength="6"
                        android:gravity="center"
                        android:text="30"
                        android:textColor="#BA68C8"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:singleLine="true" />
                </LinearLayout>
            </LinearLayout>

            <!-- زر حفظ وتطبيق إعدادات المنافذ فوراً -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApplyPorts"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="تطبيق وحفظ إعدادات المنافذ"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="#00897B"
                app:cornerRadius="12dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
